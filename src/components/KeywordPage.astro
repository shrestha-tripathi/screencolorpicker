---
/**
 * KeywordPage.astro — shared shell for keyword landing pages.
 *
 * Renders the standard pSEO layout: hero → live picker → prose sections →
 * FAQ (with FAQPage JSON-LD) → cross-link CTA. Page-specific copy is passed
 * in as props so each landing page file stays content-only.
 *
 * Brand strings are NEVER inlined here — they come from site.config.ts.
 */
import Layout from "../layouts/Layout.astro";
import ColorPicker from "../components/ColorPicker.astro";
import { site, b } from "../site.config";

export interface ProseSection {
  /** Small uppercase label above the heading */
  eyebrow: string;
  /** Section h2 */
  heading: string;
  /** Paragraphs of HTML-safe markup (rendered with set:html) */
  body: string[];
  /** Alternate background band */
  elevated?: boolean;
}

export interface Faq {
  q: string;
  a: string;
}

export interface Props {
  /** <title> */
  title: string;
  /** <meta name="description"> */
  description: string;
  /** Route path, e.g. "/hex-color-picker" */
  path: string;
  /** Small pill above the h1 */
  badge: string;
  /** h1, split so the middle word can be gradient-highlighted */
  h1Before: string;
  h1Highlight: string;
  h1After: string;
  /** Sub-headline paragraph under the h1 */
  lede: string;
  /** WebApplication schema name suffix, e.g. "HEX Color Picker" */
  appName: string;
  /** WebApplication alternateName list — the keyword cluster */
  alternateNames: string[];
  /** WebApplication featureList */
  features: string[];
  /** Main prose sections */
  sections: ProseSection[];
  /** FAQ entries — also emitted as FAQPage JSON-LD */
  faqs: Faq[];
  /** Heading above the FAQ block */
  faqHeading: string;
  /** Related links rendered in the footer CTA: [label, href] */
  related: [string, string][];
}

const {
  title,
  description,
  path,
  badge,
  h1Before,
  h1Highlight,
  h1After,
  lede,
  appName,
  alternateNames,
  features,
  sections,
  faqs,
  faqHeading,
  related,
} = Astro.props;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${site.url}${path}#webapp`,
  name: `${site.name} — ${appName}`,
  url: `${site.url}${path}`,
  description,
  alternateName: alternateNames,
  applicationCategory: "DesignApplication",
  applicationSubCategory: "ColorPicker",
  operatingSystem: "Any browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: features,
  publisher: { "@id": `${site.url}/#organization` },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${site.url}${path}#faq`,
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: `<p>${f.a}</p>` },
  })),
};
---

<Layout title={title} description={description} jsonLd={[webAppSchema, faqSchema]}>
  {/* HERO */}
  <section class="px-4 sm:px-6 pt-16 sm:pt-24 pb-8">
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-pill text-[12px] font-medium font-mono uppercase tracking-wider"
        style="background-color: var(--color-badge-bg); color: var(--color-badge-fg);"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-badge-fg);"></span>
        {badge}
      </div>

      <h1 class="heading-display text-[40px] sm:text-[52px] lg:text-[60px] text-balance">
        {h1Before}
        <span class="text-brand-gradient">{h1Highlight}</span>
        {h1After}
      </h1>
      <p
        class="mt-6 text-[17px] sm:text-[19px] leading-[1.55] text-[var(--color-fg-secondary)] max-w-2xl mx-auto text-balance"
      >
        {lede}
      </p>
    </div>
  </section>

  {/* LIVE PICKER */}
  <section class="px-4 sm:px-6 pb-16">
    <div class="mx-auto max-w-4xl">
      <ColorPicker />
    </div>
  </section>

  {/* PROSE SECTIONS */}
  {
    sections.map((s) => (
      <section
        class="px-4 sm:px-6 py-16 sm:py-20"
        style={
          s.elevated
            ? "background-color: var(--color-bg-elevated); box-shadow: inset 0 1px 0 var(--color-border), inset 0 -1px 0 var(--color-border);"
            : undefined
        }
      >
        <div class="mx-auto max-w-3xl">
          <p class="eyebrow mb-3">{s.eyebrow}</p>
          <h2 class="heading-section text-[30px] sm:text-[38px] mb-6 text-balance">{s.heading}</h2>
          <div class="grid gap-5 text-[15.5px] leading-[1.7] text-[var(--color-fg-secondary)]">
            {s.body.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {/* FAQ */}
  <section class="px-4 sm:px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-3">Questions</p>
      <h2 class="heading-section text-[30px] sm:text-[38px] mb-10 text-balance">{faqHeading}</h2>
      <div class="grid gap-3">
        {
          faqs.map((f) => (
            <details
              class="group rounded-md p-5"
              style="background-color: var(--color-bg); box-shadow: var(--shadow-ring);"
            >
              <summary
                class="cursor-pointer font-semibold text-[16px] text-[var(--color-fg)] flex items-center justify-between gap-4 list-none"
                style="letter-spacing: -0.01em;"
              >
                <span>{f.q}</span>
                <svg
                  class="w-4 h-4 text-[var(--color-muted)] transition-transform group-open:rotate-180 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </summary>
              <p class="mt-3 text-[15px] text-[var(--color-fg-secondary)] leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* CROSS-LINK CTA */}
  <section class="px-4 sm:px-6 py-16" style="box-shadow: inset 0 1px 0 var(--color-border);">
    <div class="mx-auto max-w-2xl text-center">
      <a
        href={b("/")}
        class="btn-brand inline-flex items-center justify-center gap-2 rounded-md px-6 py-3.5 text-[15px] mb-4"
      >
        Start picking colors →
      </a>
      <p class="text-[13px] text-[var(--color-fg-subtle)]">
        Also see:{" "}
        {
          related.map(([label, href], i) => (
            <>
              {i > 0 && <span> · </span>}
              <a href={b(href)} class="text-[var(--color-accent)] underline underline-offset-2">
                {label}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </section>
</Layout>
