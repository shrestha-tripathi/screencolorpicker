  appName="Figma Color Picker Alternative"
  alternateNames={[
    "figma color picker alternative",
    "figma eyedropper outside canvas",
    "figma oklch",
    "pick color from pdf for figma",
    "figma color picker plugin alternative",
    "screen color picker for designers",
  ]}
  features={[
    "Sample any screen pixel, not just the Figma canvas",
    "OKLCH output for Tailwind v4 handoff",
    "Reads PDFs, native apps, video and other browsers",
    "No plugin install and no plugin permissions",
    "Local palette history, nothing uploaded",
  ]}
  sections={sections}
  faqs={faqs}
  faqHeading="Figma alternative FAQ"
  related={[
    ["OKLCH picker", "/oklch-color-picker"],
